{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mistline",
  "version": "0.1.9",
  "identifier": "dev.mistline.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mistline",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 400,
        "decorations": false,
        "maximized": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFQkE4MzU3NEE5MUExNUIKUldSYm9aRktWNE82SGpuT3BMSGdiRHc2a2VXdjA5WW9MNmc5dE5PK2pNdzEvQ1FOeUFhZ0htUkkK",
      "endpoints": [
        "https://github.com/1Luminosity1/Amberline/releases/latest/download/latest.json"
      ]
    }
  }
}
